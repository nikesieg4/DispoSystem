# systemd-Dienst für einen Linux-Server: startet den Bot automatisch und
# nach Abstürzen neu.
#   sudo cp dispo-bot.service /etc/systemd/system/
#   sudo systemctl enable --now dispo-bot
# Pfade und Benutzer unten anpassen; den Token in /opt/dispo-bot/.env eintragen.
[Unit]
Description=Discord-Bot Zentraler Service IT
After=network-online.target
Wants=network-online.target

[Service]
User=dispo
WorkingDirectory=/opt/dispo-bot
ExecStart=/opt/dispo-bot/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
